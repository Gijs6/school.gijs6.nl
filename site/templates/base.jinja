{%- set license_text = license_label | default("Deze site is vrij te gebruiken") -%}
<!DOCTYPE html>
<html lang="nl">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>{%- block title -%}Samenvattingen :){%- endblock %} · school.gijs6.nl</title>
        <meta name="description"
              content="{%- block meta_description -%}Samenvattingen voor school{%- endblock -%}">
        <meta name="author" content="Gijs ten Berg">
        <meta name="theme-color"
              media="(prefers-color-scheme: light)"
              content="#fcfcfd">
        <meta name="theme-color"
              media="(prefers-color-scheme: dark)"
              content="#0d0f13">

        <link rel="canonical"
              href="https://school.gijs6.nl{%- block canonical_path -%}/{%- endblock -%}">

        <meta property="og:site_name" content="school.gijs6.nl">
        <meta property="og:type"
              content="{%- block og_type -%}website{%- endblock -%}">
        <meta property="og:url"
              content="https://school.gijs6.nl{%- block og_url -%}/{%- endblock -%}">
        <meta property="og:title"
              content="{%- block og_title -%}Samenvattingen · school.gijs6.nl{%- endblock -%}">
        <meta property="og:description"
              content="{%- block og_description -%}Samenvattingen voor school{%- endblock -%}">
        <meta property="og:locale" content="nl_NL">
        {%- set og_type_value = self.og_type() -%}
        {%- if og_type_value == "article" -%}
            {%- if page_created_iso %}
                <meta property="article:published_time" content="{{ page_created_iso }}">
            {% endif -%}
            {%- if page_updated_iso %}
                <meta property="article:modified_time" content="{{ page_updated_iso }}">
            {% endif -%}
        {%- endif %}

        <link rel="icon" href="/assets/images/favicon.ico">

        <link rel="preconnect" href="https://cdn.gijs6.nl" crossorigin>
        <link rel="stylesheet" href="/assets/styles/main.css">
        {% block extra_head %}{% endblock %}

        <link rel="me" href="https://gijs6.nl">
        <link rel="me" href="https://github.com/Gijs6">

        <link rel="license"
              href="https://creativecommons.org/publicdomain/zero/1.0/">

        <link rel="alternate"
              type="application/rss+xml"
              title="RSS feed"
              href="/rss.xml">
        <link rel="alternate"
              type="application/atom+xml"
              title="Atom feed"
              href="/atom.xml">
    </head>
    <body class="page{% block body_class %}{% endblock %}">
        <svg xmlns="http://www.w3.org/2000/svg"
             class="visually-hidden"
             aria-hidden="true"
             focusable="false">
            <symbol id="icon-external-link" viewBox="0 0 24 24">
            <path d="M15 3h6v6" />
            <path d="M10 14 21 3" />
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            </symbol>
            <symbol id="icon-arrow-right" viewBox="0 0 24 24">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
            </symbol>
            <symbol id="icon-arrow-left" viewBox="0 0 24 24">
            <path d="m12 19-7-7 7-7" />
            <path d="M19 12H5" />
            </symbol>
            <symbol id="icon-chevron-down" viewBox="0 0 24 24">
            <path d="m6 9 6 6 6-6" />
            </symbol>
        </svg>

        <main class="page__content">
            {% block content %}{% endblock %}
        </main>

        <footer class="page__footer">
            <ul class="page__footer-list">
                <li class="page__footer-item">
                    <address class="page__footer-address">
                        <a class="page__footer-link"
                           href="https://gijs6.nl"
                           rel="author noopener noreferrer"
                           target="_blank">Door <span class="page__footer-author">Gijs ten Berg</span></a>
                    </address>
                </li>
                <li class="page__footer-item">
                    <a class="page__footer-link"
                       href="https://creativecommons.org/publicdomain/zero/1.0/"
                       rel="license noopener noreferrer"
                       target="_blank">{{ license_text }}</a>
                </li>
                <li class="page__footer-item">
                    <a class="page__footer-link"
                       href="https://contact.gijs6.nl"
                       rel="noopener noreferrer"
                       target="_blank">Contact</a>
                </li>
                <li class="page__footer-item">
                    <a class="page__footer-link"
                       href="{{ repo_url }}/blob/main/{{ page_path }}"
                       rel="noopener noreferrer"
                       target="_blank">Bekijk deze pagina op GitHub</a>
                </li>
                <li class="page__footer-item">
                    <a class="page__footer-link" href="/rss.xml">RSS-feed</a>
                </li>
            </ul>

            <p class="page__footer-note">
                Site bijgewerkt op
                <time datetime="{{ built_at_iso }}">{{ built_at }}</time>
                {%- if page_updated %}
                    · Deze pagina gewijzigd op
                    <time datetime="{{ page_updated_iso }}">{{ page_updated }}</time>
                {%- endif %}
                {%- if commit %}
                    ·
                    <a class="page__footer-link"
                       href="{{ repo_url }}/commit/{{ commit.sha }}"
                       rel="noopener noreferrer"
                       target="_blank">Versie <span class="page__footer-commit">{{ commit.short }}</span></a>
                {%- endif %}
            </p>
        </footer>
    </body>
</html>
