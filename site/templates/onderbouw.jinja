{% extends "base.jinja" %}

{% block title %}Onderbouw{% endblock %}
{% block canonical_path %}/onderbouw/{% endblock %}
{% block og_url %}/onderbouw/{% endblock %}
{% block meta_description %}Samenvattingen uit de onderbouw{% endblock %}
{% block og_title %}Onderbouw - school.gijs6.nl{% endblock %}
{% block og_description %}Samenvattingen uit de onderbouw{% endblock %}

{% block content %}
    <nav class="page__back" aria-label="Terug">
        <a class="back-link" href="/">
            <svg class="icon" aria-hidden="true" focusable="false">
                <use href="#icon-arrow-left" />
            </svg>
            Ga terug naar home
        </a>
    </nav>

    <header class="intro">
        <h1 class="intro__title">Onderbouw</h1>
        <p class="intro__text">
            Alles wat ik in 2VWO en 3VWO in elkaar heb geknutseld. Wie weet heb je er nog wat aan :)
        </p>
    </header>

    <div class="index index--archive">
        {% for year, subjects in onderbouw_data.items() %}
            <section class="index__year" aria-labelledby="jaar-{{ year }}">
                <h2 class="index__year-label" id="jaar-{{ year }}">{{ year }}</h2>

                <div class="archive__subjects">
                    {% for subject in subjects %}
                        <section class="archive__subject"
                                 data-family="{{ subject.family }}"
                                 aria-labelledby="vak-{{ year }}-{{ loop.index }}">
                            <h3 class="archive__subject-label" id="vak-{{ year }}-{{ loop.index }}">
                                {{ subject.name }}
                            </h3>
                            <ul class="archive__chapters">
                                {% for page in subject.pages %}
                                    <li class="archive__chapter">
                                        <a class="archive__chapter-link" href="{{ page.link }}">{{ page.chapter }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    </div>
{% endblock %}
