{% extends "base.jinja" %}

{% block title %}Pagina niet gevonden{% endblock %}
{% block meta_description %}Deze pagina bestaat niet{% endblock %}
{% block og_title %}Pagina niet gevonden · school.gijs6.nl{% endblock %}
{% block og_description %}Deze pagina bestaat niet{% endblock %}

{# djlint:off #}
{% block body_class %} page--error{% endblock %}
{# djlint:on #}

{% block extra_head %}
    <script src="/assets/scripts/error.js" defer></script>
{% endblock %}

{% block footer %}{% endblock %}

{% block content %}
    <div class="error">
        <p class="error__path" hidden></p>
        <h1 class="error__title">Deze pagina bestaat niet</h1>
        <p class="error__message">Er klopt iets niet aan de link. Misschien is de samenvatting verplaatst.</p>
        <a class="error__back-link" href="/">
            <svg class="icon" aria-hidden="true" focusable="false">
                <use href="#icon-arrow-left" />
            </svg>
            Terug naar home
        </a>
    </div>
{% endblock %}
