#!/bin/bash

serve() {
  .venv/bin/python -m composer serve --dev
}

build() {
  .venv/bin/python -m composer build
  lightningcss --browserslist --bundle --minify build/assets/styles/main.css -o build/assets/styles/main.css
}

deploy() {
  build
  prettier --write --ignore-path /dev/null "build/**/*.{css,js,xml,html}"
  shake_super deploy
}
